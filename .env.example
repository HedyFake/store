# Salin berkas ini menjadi .env untuk pengembangan lokal.
# Nilai di bawah ini hanyalah placeholder contoh — jangan gunakan di produksi
# dan jangan pernah melakukan commit berkas .env ke repositori.

NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
API_PORT=4000

# PostgreSQL database
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/dropship_store?schema=public

# Redis (opsional; antrean job memiliki fallback tabel PostgreSQL bila Redis tidak tersedia)
REDIS_URL=redis://localhost:6379

# Autentikasi session & penandatanganan token akses pesanan tamu (minimal 32 karakter acak)
AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_CHARS_RANDOM_SECRET_VALUE
SESSION_TTL_HOURS=12
DEMO_MODE=true

# Penyimpanan privat untuk bukti pembayaran & PDF label resi ('local' atau 's3')
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET_PRIVATE=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Payment gateway untuk QRIS dinamis / Virtual Account ('disabled' atau 'midtrans')
PAYMENT_PROVIDER=disabled
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
ENABLE_QRIS=false
ENABLE_VIRTUAL_ACCOUNT=false
VA_BANKS=bca,bni,bri

# Telegram Bot API untuk pengiriman PDF label/resi (biarkan kosong jika belum digunakan)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_SEND_ENABLED=false
TELEGRAM_API_BASE=https://api.telegram.org

# Provider ongkir ('manual' untuk tarif flat toko atau 'rajaongkir' untuk Komerce API v1)
SHIPPING_PROVIDER=manual
RAJAONGKIR_API_KEY=
RAJAONGKIR_BASE_URL=https://rajaongkir.komerce.id/api/v1

# Batas unggahan berkas & impor CSV
PAYMENT_PROOF_MAX_BYTES=5242880
SHIPPING_DOC_MAX_BYTES=10485760
PRODUCT_IMPORT_MAX_BYTES=2097152
PRODUCT_IMPORT_MAX_ROWS=500
JOB_WORKER_ENABLED=true

# Kredensial seed awal admin demo (hanya dipakai oleh prisma/seed.ts pada pengembangan lokal)
SEED_ADMIN_EMAIL=admin@store.local
SEED_ADMIN_PASSWORD=ChangeMeAdmin!2026

