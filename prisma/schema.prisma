// Dropship multi-supplier store — PostgreSQL schema
// Money convention: all IDR amounts are stored as integer rupiah (Int). Never floats.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Enums ─────────────────────────────

enum UserRole {
  OWNER
  ADMIN
  STAFF
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum IntegrationMode {
  API
  MANUAL
  SUPPLIER_PORTAL
  WHATSAPP_MANUAL
}

enum PaymentMethod {
  BANK_TRANSFER
  QRIS_STATIC // QRIS statis milik toko: dibayar manual + bukti, diverifikasi admin
  QRIS_GATEWAY
  VIRTUAL_ACCOUNT
  COD
}

enum OrderStatus {
  PENDING_PAYMENT
  AWAITING_FULFILLMENT
  PROCESSING
  PARTIALLY_SHIPPED
  SHIPPED
  PARTIALLY_DELIVERED
  DELIVERED
  COMPLETED
  DELIVERY_FAILED
  RETURNED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PENDING_REVIEW
  PAID
  EXPIRED
  COD_PENDING_COLLECTION
  COD_COLLECTED
  COD_FAILED
  REFUNDED
  CANCELLED
}

enum ProofReviewStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum SupplierOrderStatus {
  PENDING
  SUBMITTED
  CONFIRMED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  OUT_OF_STOCK
}

enum ShipmentStatus {
  AWAITING_TRACKING // menunggu resi
  TRACKING_AVAILABLE // resi tersedia
  TRACKING_FAILED // gagal mengambil resi
  IN_TRANSIT
  DELIVERED
  DELIVERY_FAILED
  RETURNED_TO_ORIGIN
  CANCELLED
}

enum CodCollectionStatus {
  NOT_APPLICABLE
  PENDING
  COLLECTED
  FAILED
}

enum DocumentType {
  SHIPPING_LABEL
  RECEIPT
  OTHER
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
  DEAD
}

enum JobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
  DEAD
}

enum ImportMode {
  CREATE_ONLY
  UPSERT_BY_SKU
}

enum ImportStatus {
  PREVIEWED
  COMMITTED
  FAILED
}

enum SectionStatus {
  ENABLED
  DISABLED
}

// ───────────────────────────── Auth ─────────────────────────────

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  name         String
  passwordHash String
  role         UserRole   @default(STAFF)
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  sessions     Session[]
  auditLogs    AuditLog[]
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ───────────────────────────── Catalog ─────────────────────────────

model Category {
  id        String     @id @default(uuid())
  name      String
  slug      String     @unique
  icon      String?
  imageUrl  String?
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("CategoryTree")
  sortOrder Int        @default(0)
  active    Boolean    @default(true)
  products  Product[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([active, sortOrder])
}

model Product {
  id             String           @id @default(uuid())
  sku            String           @unique
  slug           String           @unique
  name           String
  description    String           @default("")
  categoryId     String?
  category       Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  status         ProductStatus    @default(DRAFT)
  salePrice      Int
  compareAtPrice Int?
  currency       String           @default("IDR")
  weightGram     Int              @default(0)
  lengthCm       Int?
  widthCm        Int?
  heightCm       Int?
  highlights     String[]         @default([])
  badges         String[]         @default([])
  featured       Boolean          @default(false)
  isDemo         Boolean          @default(false)
  seoTitle       String?
  seoDescription String?
  archivedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  images         ProductImage[]
  variants       ProductVariant[]
  offers         SupplierOffer[]
  orderItems     OrderItem[]

  @@index([status, createdAt])
  @@index([categoryId])
  @@index([featured])
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String  @default("")
  sortOrder Int     @default(0)

  @@index([productId, sortOrder])
}

model ProductVariant {
  id            String          @id @default(uuid())
  productId     String
  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku           String          @unique
  name          String // e.g. "Charcoal / Standar"
  options       Json            @default("{}")
  priceOverride Int?
  active        Boolean         @default(true)
  sortOrder     Int             @default(0)
  offers        SupplierOffer[]
  orderItems    OrderItem[]

  @@index([productId])
}

// ───────────────────────────── Suppliers & stock ─────────────────────────────

model Supplier {
  id              String          @id @default(uuid())
  name            String          @unique
  active          Boolean         @default(true)
  integrationMode IntegrationMode @default(MANUAL)
  sourcePlatform  String?
  contactName     String?
  contactPhone    String?
  contactEmail    String?
  portalUrl       String?
  externalRef     String?
  credentialRef   String? // name of env var / secret-manager key, never the secret itself
  codSupported    Boolean         @default(false)
  publicLabel     String? // safe name shown to customers (optional)
  notes           String? // internal only
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  warehouses      Warehouse[]
  offers          SupplierOffer[]
  supplierOrders  SupplierOrder[]
}

model Warehouse {
  id                  String          @id @default(uuid())
  supplierId          String
  supplier            Supplier        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  name                String
  city                String
  province            String?
  address             String?
  shippingOriginId    String? // RajaOngkir destination id for origin
  active              Boolean         @default(true)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  offers              SupplierOffer[]
  supplierOrders      SupplierOrder[]

  @@unique([supplierId, name])
}

model SupplierOffer {
  id                  String              @id @default(uuid())
  productId           String
  product             Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId           String?
  variant             ProductVariant?     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  supplierId          String
  supplier            Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouseId         String
  warehouse           Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  supplierSku         String
  supplierProductUrl  String?
  costPrice           Int
  stockQty            Int                 @default(0)
  leadTimeDays        Int                 @default(1)
  fulfillmentPriority Int                 @default(100) // lower = preferred
  codEnabled          Boolean             @default(false)
  integrationMode     IntegrationMode     @default(MANUAL)
  active              Boolean             @default(true)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  movements           InventoryMovement[]
  orderItems          OrderItem[]

  @@unique([supplierId, warehouseId, supplierSku])
  @@index([productId, active])
  @@index([variantId])
}

model InventoryMovement {
  id             String        @id @default(uuid())
  offerId        String
  offer          SupplierOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  delta          Int
  reason         String // ORDER_RESERVE, ORDER_RELEASE, MANUAL_ADJUST, IMPORT
  relatedOrderId String?
  actorId        String?
  note           String?
  createdAt      DateTime      @default(now())

  @@index([offerId, createdAt])
  @@index([relatedOrderId])
}

// ───────────────────────────── Customers & orders ─────────────────────────────

model Customer {
  id        String   @id @default(uuid())
  name      String
  phone     String   @unique // normalized 62xxxxxxxx
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
}

model ShippingQuote {
  id            String   @id @default(uuid())
  destinationId String
  payload       Json // server-computed groups & options; client only references ids
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  orders        Order[]

  @@index([expiresAt])
}

model Order {
  id                    String          @id @default(uuid())
  orderNumber           String          @unique
  guestAccessTokenHash  String
  customerId            String?
  customer              Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  recipientName         String
  phone                 String
  email                 String?
  addressLine           String
  province              String
  city                  String
  district              String
  postalCode            String?
  destinationId         String?
  customerNote          String?
  subtotal              Int
  discountTotal         Int             @default(0)
  shippingTotal         Int
  codFee                Int             @default(0)
  grandTotal            Int
  currency              String          @default("IDR")
  paymentMethod         PaymentMethod
  paymentStatus         PaymentStatus
  orderStatus           OrderStatus
  cancelReason          String?
  paymentDueAt          DateTime?
  shippingQuoteId       String?
  shippingQuote         ShippingQuote?  @relation(fields: [shippingQuoteId], references: [id], onDelete: SetNull)
  idempotencyKey        String?         @unique
  isDemo                Boolean         @default(false)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  items                 OrderItem[]
  supplierOrders        SupplierOrder[]
  payments              Payment[]
  statusHistory         OrderStatusHistory[]

  @@index([orderStatus, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([paymentMethod])
  @@index([phone])
  @@index([createdAt])
}

model OrderStatusHistory {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  field     String // orderStatus | paymentStatus
  fromValue String?
  toValue   String
  note      String?
  actorId   String?
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

model OrderItem {
  id                String          @id @default(uuid())
  orderId           String
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  supplierOrderId   String?
  supplierOrder     SupplierOrder?  @relation(fields: [supplierOrderId], references: [id], onDelete: SetNull)
  productId         String
  product           Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId         String?
  variant           ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  offerId           String
  offer             SupplierOffer   @relation(fields: [offerId], references: [id], onDelete: Restrict)
  productNameSnap   String
  skuSnap           String
  variantNameSnap   String?
  imageUrlSnap      String?
  supplierSkuSnap   String
  quantity          Int
  unitPrice         Int
  costPriceSnap     Int
  lineTotal         Int
  weightGramSnap    Int

  @@index([orderId])
  @@index([productId])
  @@index([supplierOrderId])
}

model SupplierOrder {
  id                  String              @id @default(uuid())
  orderId             String
  order               Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  supplierId          String
  supplier            Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouseId         String
  warehouse           Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  routingKey          String // supplierId:warehouseId
  sequence            Int // 1..n inside order, used for display "Paket 1"
  status              SupplierOrderStatus @default(PENDING)
  integrationMode     IntegrationMode
  externalOrderRef    String?
  purchaseCostTotal   Int
  itemsSubtotal       Int
  shippingCost        Int
  courierCode         String?
  courierService      String?
  courierEtd          String?
  idempotencyKey      String              @unique
  submittedAt         DateTime?
  confirmedAt         DateTime?
  internalNotes       String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  items               OrderItem[]
  shipments           Shipment[]

  @@unique([orderId, routingKey])
  @@index([status])
  @@index([supplierId])
}

model Shipment {
  id                  String              @id @default(uuid())
  supplierOrderId     String
  supplierOrder       SupplierOrder       @relation(fields: [supplierOrderId], references: [id], onDelete: Cascade)
  carrier             String
  carrierService      String?
  trackingNumber      String?
  trackingUrl         String?
  status              ShipmentStatus      @default(AWAITING_TRACKING)
  trackingError       String?
  externalShipmentId  String?
  codCollectionStatus CodCollectionStatus @default(NOT_APPLICABLE)
  codAmount           Int                 @default(0)
  codCollectedAt      DateTime?
  shippedAt           DateTime?
  deliveredAt         DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  documents           ShipmentDocument[]
  events              TrackingEvent[]

  @@index([trackingNumber])
  @@index([status])
}

model ShipmentDocument {
  id                 String             @id @default(uuid())
  shipmentId         String
  shipment           Shipment           @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  storageKey         String             @unique
  docType            DocumentType       @default(SHIPPING_LABEL)
  originalName       String
  mime               String
  sizeBytes          Int
  sha256             String
  source             String // ADMIN_UPLOAD | SUPPLIER | CARRIER_API
  customerVisible    Boolean            @default(true)
  uploadedById       String?
  createdAt          DateTime           @default(now())
  telegramDeliveries TelegramDelivery[]
}

model TrackingEvent {
  id              String   @id @default(uuid())
  shipmentId      String
  shipment        Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  externalEventId String?
  status          String
  message         String
  eventAt         DateTime
  source          String // ADMIN | CARRIER_API | SUPPLIER
  createdAt       DateTime @default(now())

  @@unique([shipmentId, externalEventId])
  @@index([shipmentId, eventAt])
}

// ───────────────────────────── Payments ─────────────────────────────

model Payment {
  id                    String          @id @default(uuid())
  orderId               String
  order                 Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method                PaymentMethod
  provider              String // manual | midtrans | cod
  providerTransactionId String?         @unique
  amount                Int
  currency              String          @default("IDR")
  status                PaymentStatus
  expiresAt             DateTime?
  paidAt                DateTime?
  providerPayload       Json? // redacted gateway display data (e.g. VA number, QR string)
  verifiedById          String?
  verifiedNote          String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  proofs                PaymentProof[]

  @@index([orderId])
  @@index([status])
}

model PaymentProof {
  id              String            @id @default(uuid())
  paymentId       String
  payment         Payment           @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  storageKey      String            @unique
  originalName    String
  detectedMime    String
  sizeBytes       Int
  sha256          String
  reviewStatus    ProofReviewStatus @default(PENDING_REVIEW)
  reviewedById    String?
  reviewedAt      DateTime?
  reviewedAmount  Int?
  rejectionReason String?
  reviewNote      String?
  createdAt       DateTime          @default(now())

  @@index([paymentId, createdAt])
  @@index([reviewStatus])
}

model WebhookEvent {
  id                String    @id @default(uuid())
  provider          String
  externalEventId   String
  signatureVerified Boolean
  payloadHash       String
  redactedPayload   Json
  processingStatus  String // RECEIVED | PROCESSED | REJECTED | IGNORED | FAILED
  error             String?
  retryCount        Int       @default(0)
  receivedAt        DateTime  @default(now())
  processedAt       DateTime?

  @@unique([provider, externalEventId])
}

// ───────────────────────────── Notifications & jobs ─────────────────────────────

model TelegramDelivery {
  id                 String            @id @default(uuid())
  shipmentDocumentId String?
  shipmentDocument   ShipmentDocument? @relation(fields: [shipmentDocumentId], references: [id], onDelete: SetNull)
  kind               String // DOCUMENT | TEST | MESSAGE
  chatId             String // configured identifier (masked when displayed)
  dedupeKey          String            @unique
  status             DeliveryStatus    @default(PENDING)
  attemptCount       Int               @default(0)
  lastError          String?
  telegramMessageId  String?
  sentAt             DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([status])
}

model Job {
  id          String    @id @default(uuid())
  type        String
  payload     Json
  status      JobStatus @default(PENDING)
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  runAt       DateTime  @default(now())
  lockedAt    DateTime?
  lastError   String?
  dedupeKey   String?   @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, runAt])
}

// ───────────────────────────── Imports ─────────────────────────────

model ProductImportJob {
  id            String                  @id @default(uuid())
  actorId       String
  fileName      String
  fileHash      String
  mode          ImportMode
  protectedFields String[]              @default([])
  status        ImportStatus            @default(PREVIEWED)
  totalRows     Int
  validRows     Int
  createdCount  Int                     @default(0)
  updatedCount  Int                     @default(0)
  skippedCount  Int                     @default(0)
  failedCount   Int                     @default(0)
  rows          Json // normalized valid rows kept until commit
  createdAt     DateTime                @default(now())
  committedAt   DateTime?
  errors        ProductImportRowError[]

  @@index([actorId, createdAt])
}

model ProductImportRowError {
  id        String           @id @default(uuid())
  jobId     String
  job       ProductImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  rowNumber Int
  column    String?
  sku       String?
  message   String
  phase     String // PREVIEW | COMMIT

  @@index([jobId, rowNumber])
}

// ───────────────────────────── Store config, CMS, audit ─────────────────────────────

model StoreSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model HomepageSection {
  id               String        @id @default(uuid())
  type             String // HERO | CATEGORIES | FEATURED_PRODUCTS | PROMO_BANNER | VALUE_PROPS
  sortOrder        Int
  status           SectionStatus @default(ENABLED)
  draftContent     Json
  publishedContent Json?
  draftSortOrder   Int
  draftStatus      SectionStatus @default(ENABLED)
  publishedAt      DateTime?
  version          Int           @default(1)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([sortOrder])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorLabel String?
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

