    "@prisma/client": "^5.22.0",
    "@store/shared": "1.0.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "helmet": "^8.0.0",
    "reflect-metadata": "^0.2.2",
